{
  "entities": {
    "Seller": {
      "title": "Seller",
      "description": "Commercial breaker or equipment seller yard",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "maxLength": 200 },
        "contactName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsapp": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 300 },
        "planId": { "type": "string", "maxLength": 50 },
        "subscriptionStatus": { "type": "string", "maxLength": 50 },
        "subscriptionDueDate": { "type": "string", "maxLength": 100 },
        "lastPaymentRef": { "type": "string", "maxLength": 100 },
        "paymentProofSubmittedAt": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["companyName", "contactName", "phone", "whatsapp", "email", "province", "city", "planId", "subscriptionStatus"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Auto spare, truck part, or heavy machinery inventory listing",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "maxLength": 100 },
        "sellerName": { "type": "string", "maxLength": 200 },
        "sellerPhone": { "type": "string", "maxLength": 50 },
        "sellerWhatsapp": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "make": { "type": "string", "maxLength": 100 },
        "model": { "type": "string", "maxLength": 100 },
        "year": { "type": "number" },
        "partNumber": { "type": "string", "maxLength": 100 },
        "condition": { "type": "string", "maxLength": 50 },
        "priceZar": { "type": "number" },
        "province": { "type": "string", "maxLength": 50 },
        "city": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "specifications": { "type": "object" },
        "images": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "views": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["sellerId", "title", "category", "priceZar", "province", "city"]
    },
    "OwnerSettings": {
      "title": "OwnerSettings",
      "description": "Platform administrator settings and EFT banking details",
      "type": "object",
      "properties": {
        "passwordHash": { "type": "string", "maxLength": 200 },
        "ownerEmail": { "type": "string", "maxLength": 100 },
        "ownerPhone": { "type": "string", "maxLength": 50 },
        "bankingDetails": { "type": "object" },
        "taxInvoiceSettings": { "type": "object" }
      },
      "required": ["ownerEmail", "bankingDetails"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check document to verify backend connectivity",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 50 }
      }
    },
    "SellerSpecial": {
      "title": "SellerSpecial",
      "description": "Special clearance deal or promotion published by an equipment or parts seller",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "maxLength": 100 },
        "sellerName": { "type": "string", "maxLength": 200 },
        "sellerPhone": { "type": "string", "maxLength": 50 },
        "sellerWhatsapp": { "type": "string", "maxLength": 50 },
        "sellerCity": { "type": "string", "maxLength": 100 },
        "sellerProvince": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "badge": { "type": "string", "maxLength": 100 },
        "originalPriceZar": { "type": "number" },
        "specialPriceZar": { "type": "number" },
        "description": { "type": "string", "maxLength": 2000 },
        "terms": { "type": "string", "maxLength": 500 },
        "expiresAt": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "isFeatured": { "type": "boolean" },
        "views": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["sellerId", "title", "category", "specialPriceZar", "sellerWhatsapp"]
    },
    "SellerCompetition": {
      "title": "SellerCompetition",
      "description": "Scrapyard and equipment dismantler competition with prizes and leaderboard",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "tagline": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "categoryType": { "type": "string", "maxLength": 50 },
        "prizePool": { "type": "string", "maxLength": 200 },
        "prizes": { "type": "array" },
        "startDate": { "type": "string", "maxLength": 100 },
        "endDate": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "bannerImage": { "type": "string", "maxLength": 500 },
        "rules": { "type": "array" },
        "criteria": { "type": "array" },
        "participantsCount": { "type": "number" },
        "leaderboard": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["title", "prizePool", "status", "startDate", "endDate"]
    },
    "CompetitionEntry": {
      "title": "CompetitionEntry",
      "description": "Seller yard showcase entry submitted into an active competition",
      "type": "object",
      "properties": {
        "competitionId": { "type": "string", "maxLength": 100 },
        "sellerId": { "type": "string", "maxLength": 100 },
        "sellerName": { "type": "string", "maxLength": 200 },
        "sellerWhatsapp": { "type": "string", "maxLength": 50 },
        "sellerCity": { "type": "string", "maxLength": 100 },
        "entryTitle": { "type": "string", "maxLength": 200 },
        "entryDescription": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "proofMetrics": { "type": "string", "maxLength": 200 },
        "submittedAt": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["competitionId", "sellerId", "entryTitle", "entryDescription"]
    }
  },
  "firestore": {
    "/sellers/{sellerId}": {
      "schema": "Seller",
      "description": "Collection of registered seller yards"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Collection of parts and equipment inventory"
    },
    "/specials/{specialId}": {
      "schema": "SellerSpecial",
      "description": "Collection of active seller specials and clearance deals"
    },
    "/competitions/{competitionId}": {
      "schema": "SellerCompetition",
      "description": "Collection of seller scrapyard competitions and challenges"
    },
    "/competition_entries/{entryId}": {
      "schema": "CompetitionEntry",
      "description": "Submissions and showcase entries from sellers participating in competitions"
    },
    "/owner_settings/{configId}": {
      "schema": "OwnerSettings",
      "description": "Platform global configuration and banking details"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admins collection"
    },
    "/test/{testId}": {
      "schema": "TestConnection",
      "description": "Health and connection testing document"
    }
  }
}
